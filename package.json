{
  "name": "loveni",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "date-fns": "^4.4.0",
    "expo": "~58.0.25",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-web-browser": "~58.0.8",
    "firebase": "^13.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "node scripts/ensure-windows-ninja.js && expo run:android",
    "android:enable-long-paths": "node scripts/ensure-windows-long-paths.js",
    "android:reverse": "node scripts/adb-usb.js reverse",
    "android:device": "node scripts/ensure-windows-ninja.js && node scripts/run-android-device.js",
    "android:prebuild": "expo prebuild --platform android --clean",
    "android:uninstall": "node scripts/adb-usb.js uninstall com.loveni.app",
    "android:rebuild": "npm run android:prebuild && npm run android:uninstall && npm run android:device",
    "android:rebuild:emu": "npm run android:prebuild && npm run android:uninstall && node scripts/ensure-windows-ninja.js && expo run:android",
    "ios": "expo run:ios",
    "ios:prebuild": "expo prebuild --platform ios --clean",
    "ios:rebuild": "npm run ios:prebuild && expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild --platform android",
    "typecheck": "tsc --noEmit",
    "firebase:rules": "npx -y firebase-tools@latest deploy --only firestore:rules,firestore:indexes",
    "firebase:functions": "npm --prefix functions run build && npx -y firebase-tools@latest deploy --only functions"
  },
  "private": true
}
