rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isUnpairedData(data) {
      return !('coupleId' in data) || data.coupleId == null;
    }

    function isCoupleMember(coupleId) {
      return signedIn()
        && exists(/databases/$(database)/documents/couples/$(coupleId))
        && request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.memberIds;
    }

    function linkingKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['coupleId', 'partnerId', 'updatedAt', 'updatedAtServer'])
        || request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['coupleId', 'partnerId', 'updatedAt']);
    }

    function isSelfProfileUpdate(userId) {
      return isSelf(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['coupleId', 'partnerId']);
    }

    function isSelfLink(userId) {
      return isSelf(userId)
        && isUnpairedData(resource.data)
        && request.resource.data.coupleId is string
        && request.resource.data.partnerId is string
        && linkingKeysOnly();
    }

    function isSelfUnlink(userId) {
      return isSelf(userId)
        && !isUnpairedData(resource.data)
        && request.resource.data.coupleId == null
        && request.resource.data.partnerId == null
        && linkingKeysOnly();
    }

    // Invite acceptor links the invite creator in the same transaction.
    function isPartnerLinkUpdate(userId) {
      return signedIn()
        && request.auth.uid != userId
        && isUnpairedData(resource.data)
        && request.resource.data.partnerId == request.auth.uid
        && request.resource.data.coupleId is string
        && linkingKeysOnly();
    }

    function isPartnerUnlinkUpdate() {
      return signedIn()
        && resource.data.partnerId == request.auth.uid
        && request.resource.data.coupleId == null
        && request.resource.data.partnerId == null
        && linkingKeysOnly();
    }

    match /users/{userId} {
      // Profiles are readable to signed-in users (needed for invite accept + partner sync).
      allow get: if signedIn();
      allow list: if false;

      allow create: if isSelf(userId)
        && request.resource.data.uid == userId
        && isUnpairedData(request.resource.data);

      allow update: if isSelfProfileUpdate(userId)
        || isSelfLink(userId)
        || isSelfUnlink(userId)
        || isPartnerLinkUpdate(userId)
        || isPartnerUnlinkUpdate();

      allow delete: if false;
    }

    // One invite doc per creator: invites/{uid}. Legacy docs used the code as the id.
    match /invites/{inviteId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && inviteId == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.claimedBy == null
        && request.resource.data.code is string
        && isUnpairedData(userDoc(request.auth.uid));

      allow update: if signedIn() && (
          // Creator regenerates / refreshes their single invite doc.
          (inviteId == request.auth.uid
            && resource.data.createdBy == request.auth.uid
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.status == 'open'
            && request.resource.data.claimedBy == null
            && request.resource.data.code is string
            && isUnpairedData(userDoc(request.auth.uid)))
          ||
          // Creator revokes leftover legacy invite docs.
          (resource.data.createdBy == request.auth.uid
            && resource.data.status == 'open'
            && request.resource.data.status == 'revoked')
          ||
          // Acceptor claims an open invite.
          (resource.data.status == 'open'
            && request.auth.uid != resource.data.createdBy
            && request.resource.data.status == 'claimed'
            && request.resource.data.claimedBy == request.auth.uid
            && request.resource.data.coupleId is string
            && isUnpairedData(userDoc(request.auth.uid)))
        );

      allow delete: if false;
    }

    match /couples/{coupleId} {
      allow read: if signedIn()
        && (request.auth.uid in resource.data.memberIds
            || isCoupleMember(coupleId));

      allow create: if signedIn()
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() == 2
        && request.resource.data.createdBy in request.resource.data.memberIds;

      // Active members can update; also allow reclaiming a disconnected empty shell.
      allow update: if signedIn() && (
          request.auth.uid in resource.data.memberIds
          || (
            resource.data.memberIds.size() == 0
            && request.resource.data.memberIds.size() == 2
            && request.auth.uid in request.resource.data.memberIds
            && request.resource.data.createdBy in request.resource.data.memberIds
          )
        );

      // Disconnect deletes the couple doc so reconnect can create a fresh one.
      allow delete: if signedIn()
        && request.auth.uid in resource.data.memberIds;
    }

    match /notes/{noteId} {
      allow read: if signedIn()
        && isCoupleMember(resource.data.coupleId)
        && resource.data.deleted == false;

      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && isCoupleMember(request.resource.data.coupleId)
        && request.resource.data.deleted == false
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500;

      allow update: if signedIn()
        && resource.data.fromUid == request.auth.uid
        && isCoupleMember(resource.data.coupleId)
        && (
          // Soft delete
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['deleted', 'deletedAt'])
            && request.resource.data.deleted == true
          )
          // Edit note text
          || (
            resource.data.deleted == false
            && request.resource.data.deleted == false
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['text', 'updatedAt'])
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 500
          )
        );

      allow delete: if false;
    }

    match /moods/{moodId} {
      allow read: if signedIn()
        && isCoupleMember(resource.data.coupleId)
        && (!('deleted' in resource.data) || resource.data.deleted == false);

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && isCoupleMember(request.resource.data.coupleId)
        && request.resource.data.mood in ['🥰', '😊', '😔', '😴', '🥺', '😍']
        && (!('deleted' in request.resource.data) || request.resource.data.deleted == false);

      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && isCoupleMember(resource.data.coupleId)
        && (
          // Soft delete
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['deleted', 'deletedAt'])
            && request.resource.data.deleted == true
          )
          // Edit mood + optional message
          || (
            (!('deleted' in resource.data) || resource.data.deleted == false)
            && (!('deleted' in request.resource.data) || request.resource.data.deleted == false)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['mood', 'message', 'updatedAt'])
            && request.resource.data.mood in ['🥰', '😊', '😔', '😴', '🥺', '😍']
            && (
              request.resource.data.message == null
              || (
                request.resource.data.message is string
                && request.resource.data.message.size() <= 160
              )
            )
          )
        );

      allow delete: if false;
    }
  }
}
